# Copy to .env. Connections can also write these keys locally.
# The app does not ship a sample library. Connect a real account after the developer credentials below are set.

# SQLite file. Path is relative to the prisma/ directory.
DATABASE_URL="file:../data/muzikku.db"

# Public origin used to build OAuth redirect URIs.
APP_URL="http://localhost:3000"

# AES-256-GCM key for refresh/access tokens. Use a long random string.
# Example (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Redirect URI to register: http://localhost:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Apple Music (MusicKit) ---
# Create a MusicKit key in Apple Developer → Keys. Team ID + Key ID + .p8 PEM.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_STOREFRONT="us"
# Paste the .p8 contents with literal \n line breaks, or point at a file.
APPLE_PRIVATE_KEY=""
APPLE_PRIVATE_KEY_PATH=""

# --- YouTube Music via Google OAuth + YouTube Data API v3 ---
# Redirect URI: http://localhost:3000/api/auth/youtube/callback
# Enable YouTube Data API v3 on the Google Cloud project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
